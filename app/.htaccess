# Bu klasore tarayicidan DOGRUDAN erisim engellenir (orn. birisi
# tarayicida bu klasorun tam yolunu yazarsa 403 alir). PHP'nin kendi
# icinde bu dosyalari require/include etmesini ETKİLEMEZ - Apache'nin
# HTTP istegi engelleme kurali sadece disaridan gelen web isteklerini
# durdurur, index.php'nin bu klasorleri okumasini durdurmaz.
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>
