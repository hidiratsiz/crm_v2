# JobPro - Ortam Degiskenleri
# Bu dosyayi ".env" olarak kopyalayin ve gercek degerlerinizi girin.
# ".env" dosyasi asla git'e commit edilmez (.gitignore icinde haric tutulur)
# ve web'den erisim .htaccess ile engellenmistir.

APP_ENV=production
APP_DEBUG=false
APP_URL=https://yourdomain.com
APP_TIMEZONE=Europe/Istanbul

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=jobpro_db
DB_USER=jobpro_user
DB_PASS=CHANGE_ME

# migrate.php'yi koruyan uzun rastgele sifre.
# Uretmek icin: php -r "echo bin2hex(random_bytes(32));"
MIGRATE_TOKEN=CHANGE_ME_TO_A_LONG_RANDOM_SECRET

# Calisanlara is atama bildirimi e-postasi bu adresten gonderilir
MAIL_FROM_ADDRESS=no-reply@yourdomain.com
MAIL_FROM_NAME=JobPro

# Hizli Kayit (AI destekli kutu) icin saglayici secimi: anthropic | openai | gemini | openai_compatible
AI_PROVIDER=gemini

# console.anthropic.com uzerinden alinir
ANTHROPIC_API_KEY=CHANGE_ME_ANTHROPIC_API_KEY
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# platform.openai.com uzerinden alinir (AI_PROVIDER=openai ise kullanilir)
OPENAI_API_KEY=CHANGE_ME_OPENAI_API_KEY
OPENAI_MODEL=gpt-4o-mini

# aistudio.google.com/apikey uzerinden alinir (AI_PROVIDER=gemini ise kullanilir)
GEMINI_API_KEY=CHANGE_ME_GEMINI_API_KEY
GEMINI_MODEL=gemini-3.5-flash

# AI_PROVIDER=openai_compatible ise kullanilir (kendi sunucunuz veya baska bir saglayici)
AI_COMPATIBLE_API_KEY=
AI_COMPATIBLE_MODEL=
AI_COMPATIBLE_API_URL=
